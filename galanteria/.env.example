# Copy this file to `.env` and fill in the values from
# Supabase Dashboard -> Settings -> API.
#
# Both variables are REQUIRED. Without them the site builds and deploys
# "successfully" but every page renders an empty catalogue.
#
# Anything prefixed with VITE_ is compiled into the public JavaScript bundle and
# is readable by anyone. That is fine for the anon key below, which is designed
# to be public and is constrained by the Row Level Security policies in
# supabase/migrations/. It is NOT fine for anything else:
#
#   * NEVER put the `service_role` key here. It bypasses all security rules.
#   * NEVER put a password here. The old VITE_ADMIN_PASSWORD was readable in
#     the shipped bundle by anyone who pressed Ctrl+U. Admin login now uses
#     Supabase Auth instead — see supabase/README.md.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
